# ─── Database ────────────────────────────────────────────────────────
# Local SQLite database (works out of the box for local development)
DATABASE_URL="file:./dev.db"

# For production (PostgreSQL / Supabase / Neon), change provider to "postgresql" in prisma/schema.prisma and use:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ─── NextAuth.js ─────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ─── Admin access ────────────────────────────────────────────────────
ADMIN_EMAIL="pivon.agency@gmail.com"

# ─── Optional — Email notifications (Resend) ────────────────────────
RESEND_API_KEY=""
PIVON_TEAM_EMAIL="team@pivon.ai"
