generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── NextAuth required models ───────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User Model ─────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String    // bcrypt-hashed
  phone         String?
  location      String?
  business      String?
  motive        String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  payments Payment[]

  @@index([email])
  @@index([createdAt])
}

// ─── Payment tracking (UPI) ────────────────────────────────────────

model Payment {
  id               String   @id @default(cuid())
  userId           String
  plan             String   // "Trial", "Starter", "Growth"
  amount           Int      // amount in INR (e.g. 999)
  upiTransactionId String   // user-submitted UPI reference / transaction ID
  status           String   @default("PENDING") // PENDING | VERIFIED | REJECTED
  createdAt        DateTime @default(now())
  verifiedAt       DateTime?
  verifiedBy       String?  // admin email who verified

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ─── Lead capture ──────────────────────────────────────────────────

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String?
  company   String
  phone     String
  location  String?
  business  String?
  motive    String?
  intent    String?
  source    String   @default("landing")
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// ─── Visitor analytics ─────────────────────────────────────────────

model VisitorEvent {
  id          String   @id @default(cuid())
  event       String
  scrollDepth Int?
  durationMs  Int?
  userAgent   String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([event])
  @@index([createdAt])
}
